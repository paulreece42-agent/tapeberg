# Tapeberg worker — root cron, once a minute, single instance via flock.
#
# Install with:
#   sudo install -o root -g root -m 644 deploy/tapeberg-worker.cron /etc/cron.d/tapeberg
#   sudo install -o root -g root -m 755 tapeberg /usr/local/bin/tapeberg
#   sudo mkdir -p /var/lib/tapeberg
#
# Adjust the drive/changer/buffer paths to your rig. TAPEBERG_DB_URL comes
# from .env (keep it free of spaces and shell metacharacters).
* * * * * root . /home/major/tapeberg/.env && TAPEBERG_DRIVE=/dev/nst1 TAPEBERG_CHANGER=robot TAPEBERG_BUFFER=/var/lib/tapeberg flock -n /run/tapeberg.lock /usr/local/bin/tapeberg worker >>/var/log/tapeberg.log 2>&1
